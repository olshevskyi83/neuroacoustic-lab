# NeuroAcoustic Lab environment overrides
# Copy to .env and adjust. Do not commit .env.

# Path to SQLite database (Milestone 4+)
NEUROACOUSTIC_DATABASE=data/db/neuroacoustic.sqlite

# Default output directory for fingerprints and plots
NEUROACOUSTIC_OUTPUT_DIR=data/output

# Optional path to config TOML (defaults to config/default.toml)
# NEUROACOUSTIC_CONFIG=config/default.toml

# Optional analysis sample rate override (Hz). Empty = preserve native rate.
# NEUROACOUSTIC_ANALYSIS_SAMPLE_RATE=44100

# Logging level: DEBUG, INFO, WARNING, ERROR
NEUROACOUSTIC_LOG_LEVEL=INFO
