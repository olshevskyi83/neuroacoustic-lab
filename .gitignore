# Virtual environments
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Environment / secrets
.env
.env.local

# Databases
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# Data directories (keep structure via .gitkeep)
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
data/db/*
!data/db/.gitkeep
data/pilot-library/
# Ephemeral demos / local scratch (not user source libraries)
data/tmp/
data/tmp_*/
work/

# Generated audio fixtures (keep directory)
tests/fixtures/*
!tests/fixtures/.gitkeep
!tests/fixtures/README.md

# Generated plots and artifacts
*.png
*.svg
*.pdf
*.fingerprint.json
plots/
artifacts/

# Temporary FFmpeg / decode scratch
*.tmp
*.temp
/tmp_ffmpeg_*
ffmpeg_*.wav
ffprobe_*.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/
